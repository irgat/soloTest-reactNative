{
  "expo": {
    "name": "Solo Test",
    "slug": "soloTest",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/images/icon.png",
    "scheme": "solotest",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.irgat.soloTest"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2a2a2a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "icon": "./assets/images/android-icon-legacy.png",
      "predictiveBackGestureEnabled": false,
      "package": "com.irgat.soloTest"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2a2a2a",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 400,
          "android": {
            "backgroundColor": "#2a2a2a",
            "image": "./assets/images/android-splash-icon.png",
            "imageWidth": 288
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
